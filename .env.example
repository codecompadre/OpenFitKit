# Offline by default. uv run --env-file .env openfitkit loads a local .env explicitly.
OPENFITKIT_PROVIDER=demo

# For live coaching, change the provider above to openrouter.
# Set the exact publisher/model ID from https://openrouter.ai/models and an OpenRouter key.
# Keys stay on the Python server. Never commit your real .env file.
OPENFITKIT_MODEL=
OPENROUTER_API_KEY=

# Legacy OPENFITKIT_API_KEY is a fallback only with provider=openrouter.
# OPENROUTER_API_KEY takes precedence. Neither accepts an OpenAI/Gemini key.

# Optional. Defaults to a private app folder outside the checkout.
# OPENFITKIT_DATA_DIR=/absolute/path/to/your/private/openfitkit-data
OPENFITKIT_PORT=8766
