# Offline by default. uv run --env-file .env openfitkit loads a local .env explicitly.
OPENFITKIT_PROVIDER=demo

# For live coaching, choose openai or openrouter and set that provider's exact model ID.
# Keys stay on the Python server. Never commit your real .env file.
OPENFITKIT_MODEL=
OPENFITKIT_API_KEY=

# Optional. Defaults to a private app folder outside the checkout.
# OPENFITKIT_DATA_DIR=/absolute/path/to/your/private/openfitkit-data
OPENFITKIT_PORT=8766
